<% content_for :preheader do %>
  <%= t('mailers.future_letter.preheader') %>
<% end %>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td align="left">
            <span style="display: inline-block; border: 1px dashed #2C485E; color: #2C485E; font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 11px; padding: 4px 10px; text-transform: uppercase; letter-spacing: 0.12em; border-radius: 2px;">
              <%= t('mailers.future_letter.written_on', date: I18n.l(@letter.created_at.to_date, format: :long)) %>
            </span>
          </td>
          <td align="right">
            <span style="font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 11px; color: #7A7268; letter-spacing: 0.05em;">
              № TE-<%= @letter.id.to_s.rjust(5, '0') %>
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 20px; padding-bottom: 16px; border-bottom: 1px solid #D8D2C2;">
      <h1 style="margin: 0; font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: 600; line-height: 1.35; color: #1A1A1A;">
        <%= t('mailers.future_letter.header') %>
      </h1>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 24px; padding-bottom: 20px;">
      <div style="font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 14px; line-height: 1.8; color: #2C2A29; white-space: pre-wrap; word-break: break-word; background-color: #FAF9F5; padding: 18px 20px; border: 1px solid #D8D2C2; border-radius: 4px; margin: 0;"><%= truncate(@letter.content, length: 160, separator: ' ', omission: '…') %></div>
      <p style="margin: 18px 0 0 0; font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-style: italic; font-size: 15px; line-height: 1.5; color: #2C485E; text-align: center; font-weight: 500;">
        <%= t('mailers.future_letter.view_full_prompt') %>
      </p>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding-top: 8px; padding-bottom: 28px;">
      <a class="btn-carmine mobile-btn" href="<%= Rails.application.routes.url_helpers.letter_url(@letter.signed_id, host: ENV.fetch('APP_HOST') { 'localhost:3000' }) %>">
        <%= t('mailers.future_letter.open_btn') %>
      </a>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 20px; border-top: 1px solid #D8D2C2;">
      <div style="font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-style: italic; font-size: 13px; line-height: 1.6; color: #7A7268; text-align: center;">
        <%= t('mailers.future_letter.footer_html').html_safe %>
      </div>
    </td>
  </tr>
</table>
