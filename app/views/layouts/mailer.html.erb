<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      background-color: #EFECE3;
      font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #1A1A1A;
    }
    table {
      border-collapse: separate;
    }
    img {
      border: 0;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }
    a {
      color: #8E2818;
    }
    .btn-carmine {
      display: inline-block;
      background-color: #8E2818;
      color: #FAF9F5 !important;
      text-decoration: none;
      padding: 14px 30px;
      border-radius: 4px;
      font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.02em;
      border: 1px solid #6A1E12;
      box-shadow: 0 2px 6px rgba(142, 40, 24, 0.25);
    }
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 20px 12px !important;
      }
      .email-container {
        width: 100% !important;
        margin: 0 !important;
      }
      .paper-sheet {
        padding: 28px 20px !important;
      }
      .mobile-full-width {
        width: 100% !important;
        display: block !important;
      }
      .mobile-btn {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
        text-align: center !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #EFECE3; -webkit-font-smoothing: antialiased;">
  <% if content_for?(:preheader) %>
    <div style="display: none; max-height: 0px; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #EFECE3; opacity: 0;">
      <%= yield :preheader %>
    </div>
  <% end %>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #EFECE3; table-layout: fixed;">
    <tr>
      <td align="center" class="email-wrapper" style="padding: 40px 16px;">
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 580px; margin: 0 auto;">
          <tr>
            <td align="center" style="padding-bottom: 24px;">
              <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center">
                    <span style="font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-size: 26px; font-weight: 600; color: #1A1A1A; letter-spacing: -0.01em; text-decoration: none;">
                      <%= t('brand') %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top: 4px;">
                    <span style="font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #2C485E;">
                      <%= t('brand') %> &middot; <%= t('mailers.common.postal_archive') %>
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td class="paper-sheet" style="background-color: #FAF9F5; border: 1px solid #D8D2C2; border-radius: 4px; padding: 40px 36px; box-shadow: 0 4px 20px rgba(44, 72, 94, 0.06);">
              <%= yield %>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding-top: 28px; padding-bottom: 16px;">
              <p style="margin: 0; font-family: 'IBM Plex Sans', -apple-system, sans-serif; font-size: 12px; line-height: 1.6; color: #7A7268; text-align: center;">
                <%= t('footer_copy') %>
              </p>
              <p style="margin: 6px 0 0 0; font-family: 'IBM Plex Sans', -apple-system, sans-serif; font-size: 11px; line-height: 1.5; color: #9C958C; text-align: center;">
                <%= t('mailers.common.postal_address') %>
              </p>
              <p style="margin: 4px 0 0 0; font-family: 'Courier Prime', 'Courier New', Courier, monospace; font-size: 11px; color: #9C958C; text-align: center;">
                &sect; <%= t('brand') %> &middot; timeecho.me
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
