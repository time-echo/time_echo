<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="timeecho" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "TimeEcho — #{t('slogan')}" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TimeEcho">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= t('landing.subtitle') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flatpickr", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/google_analytics" %>
  </head>

  <body class="bg-base-100 text-base-content font-sans-ui min-h-screen flex flex-col antialiased selection:bg-secondary">
    <!-- Active Layout Switcher -->
    <%
      current_route = "#{controller_path}/#{action_name}"
      no_sidebar_pages = %w[pages/landing sessions/new check_emails/show letter_successes/show]
      show_sidebar = user_signed_in? && !no_sidebar_pages.include?(current_route)
    %>

    <% if show_sidebar %>
      <!-- Desktop & Mobile Responsive Sidebar Layout -->
      <div class="flex flex-col md:flex-row min-h-screen w-full">
        <!-- Sidebar Navigation (Desktop only, sticky) -->
        <aside class="hidden md:flex w-72 h-screen sticky top-0 bg-base-200/50 border-r border-base-200 p-8 flex-col justify-between shrink-0 font-sans-ui">
          <div class="space-y-10">
          <!-- Brand Logo -->
          <div class="flex items-center justify-between">
            <a href="<%= root_path %>" class="flex items-center text-2xl font-serif-editorial italic text-base-content tracking-tight font-semibold">
              <span><%= t('brand') %></span>
            </a>

            <%= button_to locales_path(locale: toggle_locale), method: :post, class: "flex items-center gap-1.5 text-base-content/60 hover:text-brand transition-colors cursor-pointer bg-transparent border-none p-0 font-sans-ui", aria: { label: (I18n.locale == :en ? "Cambiar idioma a español" : "Switch language to English") }, data: { turbo: "false" } do %>
              <%= tabler_icon("world", size: 16) %>
              <span class="text-xs font-medium"><%= I18n.locale == :en ? "EN" : "ES" %></span>
            <% end %>
          </div>

            <!-- Navigation Links -->
            <nav class="space-y-2 font-sans-ui">
              <!-- Write Letter -->
              <% write_active = current_page?(new_letter_path) %>
              <a href="<%= new_letter_path %>" class="flex items-center gap-3.5 px-4 py-3 rounded-lg text-sm font-medium transition-colors duration-150 <%= write_active ? 'bg-primary text-primary-content' : 'text-base-content/70 hover:bg-base-200 hover:text-primary' %>">
                <%= tabler_icon("edit", size: 18) %>
                <span><%= t('navigation.write') %></span>
              </a>

              <!-- My Letters -->
              <% vault_active = current_page?(dashboard_path) && !params[:timeline] %>
              <a href="<%= dashboard_path %>" class="flex items-center gap-3.5 px-4 py-3 rounded-lg text-sm font-medium transition-colors duration-150 <%= vault_active ? 'bg-primary text-primary-content' : 'text-base-content/70 hover:bg-base-200 hover:text-primary' %>">
                <%= tabler_icon("mail", size: 18) %>
                <span><%= t('navigation.vault') %></span>
              </a>

              <!-- Timeline -->
              <% timeline_active = current_page?(dashboard_path) && params[:timeline] %>
              <a href="<%= dashboard_path(timeline: true) %>" class="flex items-center gap-3.5 px-4 py-3 rounded-lg text-sm font-medium transition-colors duration-150 <%= timeline_active ? 'bg-primary text-primary-content' : 'text-base-content/70 hover:bg-base-200 hover:text-primary' %>">
                <%= tabler_icon("clock", size: 18) %>
                <span><%= t('navigation.timeline') %></span>
              </a>

              <!-- Analytics -->
              <% analytics_active = current_page?(analytics_path) %>
              <a href="<%= analytics_path %>" class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-colors duration-150 <%= analytics_active ? 'bg-primary text-primary-content' : 'text-base-content/70 hover:bg-base-200 hover:text-primary' %>">
                <%= tabler_icon("chart-bar", size: 18) %>
                <span><%= t('navigation.analytics') %></span>
              </a>

              <!-- Settings -->
              <% settings_active = current_page?(settings_path) %>
              <a href="<%= settings_path %>" class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-colors duration-150 <%= settings_active ? 'bg-primary text-primary-content' : 'text-base-content/70 hover:bg-base-200 hover:text-primary' %>">
                <%= tabler_icon("settings", size: 18) %>
                <span><%= t('navigation.settings') %></span>
              </a>
            </nav>
          </div>

          <!-- Bottom Quote & User Card -->
          <div class="space-y-6">
            <!-- Inspirational Quote -->
            <div class="border border-base-200 bg-base-200/40 p-4 rounded-xl space-y-2 select-none">
              <p class="text-xs font-serif-editorial italic text-base-content/70 leading-relaxed font-normal">
                 "<%= t('navigation.quote') %>"
              </p>
            </div>

            <!-- Active User -->
            <% if user_signed_in? %>
              <div class="flex items-center justify-between border-t border-base-200 pt-4 font-sans-ui">
                <div class="min-w-0 flex-1">
                  <p class="text-xs text-base-content/50 font-medium truncate pr-2"><%= current_user_email %></p>
                </div>
                <%= button_to logout_path, method: :delete, class: "btn btn-ghost btn-circle btn-sm text-error hover:bg-error/10 cursor-pointer flex items-center justify-center transition-transform duration-200 hover:scale-105 active:scale-95", data: { turbo: "false" }, "aria-label": t('navigation.sign_out') do %>
                  <%= tabler_icon("logout", size: 16) %>
                <% end %>
              </div>
            <% else %>
              <a href="<%= login_path %>" class="btn btn-primary text-primary-content btn-sm rounded-xl w-full text-xs font-medium border-none cursor-pointer hover:scale-[1.02] active:scale-[0.98] transition-transform duration-200 font-sans-ui">
                <%= t('navigation.sign_in') %>
              </a>
            <% end %>
          </div>
        </aside>

        <!-- Mobile Top Navbar -->
        <header class="md:hidden sticky top-0 z-50 bg-base-100/90 backdrop-blur-md border-b border-base-200 px-4 py-3 flex items-center justify-between font-sans-ui">
          <a href="<%= root_path %>" class="flex items-center text-xl font-serif-editorial italic text-base-content tracking-tight font-semibold shrink-0">
            <span><%= t('brand') %></span>
          </a>

          <div class="flex items-center gap-2.5 shrink-0">
            <%= button_to locales_path(locale: toggle_locale), method: :post, class: "flex items-center gap-1 text-base-content/60 hover:text-brand transition-colors cursor-pointer bg-transparent border-none p-1 hover:scale-[1.02] active:scale-[0.98] shrink-0", data: { turbo: "false" } do %>
              <%= tabler_icon("world", size: 16) %>
              <span class="text-xs font-medium"><%= I18n.locale == :en ? "EN" : "ES" %></span>
            <% end %>

            <!-- Mobile Menu Dropdown -->
            <details class="dropdown dropdown-end dropdown-bottom">
              <summary class="btn btn-ghost btn-circle btn-sm list-none cursor-pointer" aria-label="<%= t('navigation.open_menu', default: 'Menu') %>">
                <%= tabler_icon("menu-2", size: 20) %>
              </summary>
              <ul class="menu dropdown-content bg-base-100 border border-base-200 rounded-box w-52 p-2 shadow-md gap-1 z-50 font-sans-ui">
                <li><a href="<%= new_letter_path %>" class="py-2 flex items-center gap-2"><%= tabler_icon("edit", size: 16) %> <%= t('navigation.write') %></a></li>
                <li><a href="<%= dashboard_path %>" class="py-2 flex items-center gap-2"><%= tabler_icon("mail", size: 16) %> <%= t('navigation.vault') %></a></li>
                <li><a href="<%= dashboard_path(timeline: true) %>" class="py-2 flex items-center gap-2"><%= tabler_icon("clock", size: 16) %> <%= t('navigation.timeline') %></a></li>
                <li><a href="<%= analytics_path %>" class="py-2 flex items-center gap-2"><%= tabler_icon("chart-bar", size: 16) %> <%= t('navigation.analytics') %></a></li>
                <li><a href="<%= settings_path %>" class="py-2 flex items-center gap-2"><%= tabler_icon("settings", size: 16) %> <%= t('navigation.settings') %></a></li>
                <% if user_signed_in? %>
                  <div class="divider my-1"></div>
                  <li class="px-3 py-1.5 text-[10px] text-base-content/40 truncate"><%= current_user_email %></li>
                  <li><%= button_to logout_path, method: :delete, class: "text-error py-2 text-left w-full cursor-pointer flex items-center gap-2", data: { turbo: "false" } do %><%= tabler_icon("logout", size: 16) %> <%= t('navigation.sign_out') %><% end %></li>
                <% else %>
                  <li><a href="<%= login_path %>" class="py-2 font-medium text-primary flex items-center gap-2"><%= tabler_icon("login", size: 16) %> <%= t('navigation.sign_in') %></a></li>
                <% end %>
              </ul>
            </details>
          </div>
        </header>

        <!-- Right Content Area -->
        <main class="flex-grow min-h-screen bg-base-100 p-4 sm:p-8 md:p-12 overflow-x-hidden font-sans">
          <div id="flash-container">
            <% if flash[:notice].present? %>
              <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] border-l-4 border-l-[#2C485E] dark:border-l-[#77A3C4] shadow-xs flex items-center gap-3.5 py-3 px-5 mb-6 animate-fade-in max-w-5xl mx-auto text-base-content w-full font-letter text-xs">
                <%= tabler_icon("sparkles", size: 16, class: "text-[#2C485E] dark:text-[#77A3C4] shrink-0") %>
                <span class="font-medium leading-relaxed"><%= flash[:notice] %></span>
              </div>
            <% end %>
            <% if flash[:alert].present? %>
              <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] border-l-4 border-l-[#8E2818] shadow-xs flex items-center gap-3.5 py-3 px-5 mb-6 animate-fade-in max-w-5xl mx-auto text-base-content w-full font-letter text-xs">
                <%= tabler_icon("alert-triangle", size: 16, class: "text-[#8E2818] shrink-0") %>
                <span class="font-medium leading-relaxed"><%= flash[:alert] %></span>
              </div>
            <% end %>
          </div>

          <%= yield %>
        </main>
      </div>
    <% else %>
      <!-- Clean Full-Width Layout (for Landing, Login, Success pages) -->
      <header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur-md border-b border-base-200/60 font-sans-ui">
        <div class="max-w-6xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between gap-3">
          <a href="<%= root_path %>" class="flex items-center text-xl sm:text-2xl font-serif-editorial italic text-base-content tracking-tight font-semibold shrink-0">
            <span><%= t('brand') %></span>
          </a>

          <div class="flex items-center gap-2.5 sm:gap-6 md:gap-8 text-xs sm:text-sm font-medium font-sans-ui shrink-0">
            <%= button_to locales_path(locale: toggle_locale), method: :post, class: "flex items-center gap-1 sm:gap-1.5 text-base-content/60 hover:text-brand transition-colors cursor-pointer bg-transparent border-none p-1 sm:p-0 hover:scale-[1.02] active:scale-[0.98] font-sans-ui shrink-0", aria: { label: (I18n.locale == :en ? "Cambiar idioma a español" : "Switch language to English") }, data: { turbo: "false" } do %>
              <%= tabler_icon("world", size: 16) %>
              <span class="text-xs sm:text-sm"><%= I18n.locale == :en ? "EN" : "ES" %></span>
            <% end %>

            <div class="hidden sm:block h-5 w-px bg-base-300"></div>

            <a href="<%= root_path %>#how-it-works" class="hidden sm:block text-base-content/60 hover:text-brand transition-colors whitespace-nowrap"><%= t('landing.how_it_works') %></a>

            <% if user_signed_in? %>
              <a href="<%= dashboard_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs px-3 sm:px-4 py-1.5 sm:py-2 text-[11px] sm:text-xs font-semibold tracking-wider uppercase border-none cursor-pointer inline-flex items-center gap-1 sm:gap-1.5 font-letter shadow-xs whitespace-nowrap shrink-0">
                <%= tabler_icon("mail", size: 14) %>
                <span><%= t('navigation.vault') %></span>
              </a>
            <% else %>
               <a href="<%= login_path %>" class="btn bg-[#8E2818] hover:bg-[#6A1E12] text-[#FAF9F5] rounded-xs px-3 sm:px-4 py-1.5 sm:py-2 text-[11px] sm:text-xs font-semibold tracking-wider uppercase border-none cursor-pointer inline-flex items-center gap-1 sm:gap-1.5 font-letter shadow-xs whitespace-nowrap shrink-0">
                 <%= tabler_icon("login", size: 14) %>
                 <span><%= t('navigation.sign_in') %></span>
               </a>
            <% end %>
          </div>
        </div>
      </header>


      <main class="flex-grow max-w-6xl mx-auto px-4 md:px-6 py-10 w-full font-sans-ui">
        <!-- Flash Banners -->
        <% if flash[:notice].present? %>
          <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] border-l-4 border-l-[#2C485E] dark:border-l-[#77A3C4] shadow-xs flex items-center gap-3.5 py-3 px-5 mb-6 animate-fade-in text-base-content w-full font-letter text-xs">
            <%= tabler_icon("sparkles", size: 16, class: "text-[#2C485E] dark:text-[#77A3C4] shrink-0") %>
            <span class="font-medium leading-relaxed"><%= flash[:notice] %></span>
          </div>
        <% end %>
        <% if flash[:alert].present? %>
          <div class="paper-sheet rounded-xs border border-[#D8D2C2] dark:border-[#2D3340] border-l-4 border-l-[#8E2818] shadow-xs flex items-center gap-3.5 py-3 px-5 mb-6 animate-fade-in text-base-content w-full font-letter text-xs">
            <%= tabler_icon("alert-triangle", size: 16, class: "text-[#8E2818] shrink-0") %>
            <span class="font-medium leading-relaxed"><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>

      <!-- Beautiful Minimalist Footer -->
      <footer class="footer footer-center p-8 bg-base-200/50 border-t border-base-200 text-base-content/60 font-sans">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between w-full gap-4 text-xs">
          <aside class="flex items-center gap-2">
            <span>&copy; <%= Time.current.year %> TimeEcho. <%= t('footer_copy') %></span>
          </aside>
          <nav class="flex gap-4 items-center">
            <a href="<%= about_path %>" class="hover:text-primary transition-colors"><%= t('pages.footer.about') %></a>
            <a href="<%= privacy_path %>" class="hover:text-primary transition-colors"><%= t('pages.footer.privacy') %></a>
            <a href="<%= terms_path %>" class="hover:text-primary transition-colors"><%= t('pages.footer.terms') %></a>
            <span class="font-serif italic text-base-content/40"><%= t('slogan') %></span>
          </nav>
        </div>
      </footer>
    <% end %>
  </body>
</html>
