# ⏳ TimeEcho Backend Environment Configuration

# Frontend Application Host (used in email links and OAuth redirect URIs)
APP_HOST=localhost:3001
APP_PROTOCOL=http

# Product Analytics (PostHog Ruby SDK)
# Disabled by default in development and test environments.
# Secrets live in Rails credentials (posthog.api_key, analytics.user_id_secret), not ENV:
#   bin/rails credentials:edit --environment production
ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=development
POSTHOG_HOST=https://us.i.posthog.com

# Social Login (OAuth 2.0 PKCE - Google & Facebook)
# Redirect URIs are built from APP_PROTOCOL://APP_HOST.
# Registered redirect URIs:
#   {APP_PROTOCOL}://{APP_HOST}/api/auth/oauth/google/callback
#   {APP_PROTOCOL}://{APP_HOST}/api/auth/oauth/facebook/callback
# Secrets live in Rails credentials (google.client_id, google.client_secret,
# facebook.app_id, facebook.app_secret):
#   bin/rails credentials:edit --environment development
#   bin/rails credentials:edit --environment production

