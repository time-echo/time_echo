# ⏳ TimeEcho Backend Environment Configuration

# Frontend Application Host (used in email links for magic login, letters, and confirmations)
APP_HOST=localhost:3001
APP_PROTOCOL=http

# Product Analytics (PostHog Ruby SDK)
# Disabled by default in development and test environments.
# Secrets live in Rails credentials (posthog.api_key, analytics.user_id_secret), not ENV:
#   bin/rails credentials:edit --environment production
ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=development
POSTHOG_HOST=https://us.i.posthog.com
